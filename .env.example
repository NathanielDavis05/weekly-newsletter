# Postgres connection string (Vercel Postgres / Neon integration provides this).
# Either DATABASE_URL or POSTGRES_URL is accepted.
DATABASE_URL=

# Vercel Blob read/write token (the Vercel Blob integration provides this).
BLOB_READ_WRITE_TOKEN=

# Editor login password.
EDITOR_PASSWORD=change-me

# Long random string used to sign the editor session cookie.
EDITOR_SESSION_SECRET=replace-with-a-long-random-string

# Absolute site URL, used for Open Graph / social metadata links.
NEXT_PUBLIC_SITE_URL=https://cfawestbryan.com
